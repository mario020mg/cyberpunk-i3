configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Apps";
    display-window: "Windows";
    font: "DejaVu Sans Mono 10";
}
* {
    bg: #0d0221; bg-alt: #1f0a3d; fg: #e6dcff; accent: #ff2a9e; cyan: #00ebff;
    background-color: @bg; text-color: @fg;
}
window { width: 40%; border: 2px; border-color: @accent; padding: 8px; }
inputbar { children: [prompt, entry]; spacing: 8px; padding: 6px; background-color: @bg-alt; }
prompt { text-color: @cyan; background-color: inherit; }
entry { background-color: inherit; }
listview { lines: 10; padding: 6px 0 0 0; }
element { padding: 4px 6px; }
element selected { background-color: @accent; text-color: @bg; }
element-text, element-icon { background-color: inherit; text-color: inherit; }
element-icon { size: 1.2em; }
